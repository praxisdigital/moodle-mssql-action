<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/testmssql/db" VERSION="2024120900" COMMENT="XMLDB file for Moodle local/morris"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_testmssql_notnull" COMMENT="Test not null table">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"
            COMMENT="Primarty ID"/>
        <FIELD NAME="field_int" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"
            COMMENT="Integer field"/>
        <FIELD NAME="field_char" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"
            COMMENT="Varchar field"/>
        <FIELD NAME="field_text" TYPE="text" NOTNULL="true" SEQUENCE="false"
            COMMENT="Text field"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="index_fields" UNIQUE="true" FIELDS="field_int, field_char"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
